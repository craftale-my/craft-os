# Copy to tools/print-agent/.env (git-ignored) and fill in. DEV project only.
SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_ANON_KEY=<dev anon key>
AGENT_EMAIL=<a staff login of the shop, e.g. the dev test login>
AGENT_PASSWORD=<the password set in Task 0>
TICKET_COLS=48   # measured on the ZyWell ZY301
# Tickets older than this many minutes are skipped (left pending) instead of printed on start.
MAX_AGE_MIN=30
